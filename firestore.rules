rules_version = '2';

// The Chosen — access is decided by the caller's rank. Each rank carries a
// permission map (see src/lib/types.ts); rank order 0 is the top of the family
// and implicitly holds every permission. Officers can only act on members and
// ranks that sit strictly below their own rank.
//
// Member ids vs sign-in accounts: a member's id is the uid of the account they
// registered with. After a PIN reset they sign in with a fresh Firebase Auth
// account, linked back to their member id through authLinks/{authUid}. The
// member doc's `authUid` names the one account currently allowed to act for
// them (absent = the original account), so old accounts/PINs stop working.
service cloud.firestore {
  match /databases/{database}/documents {

    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function rankPath(id) { return /databases/$(database)/documents/ranks/$(id); }
    function bootstrapPath() { return /databases/$(database)/documents/meta/bootstrap; }
    function linkPath() { return /databases/$(database)/documents/authLinks/$(request.auth.uid); }
    function resetPath(memberId) { return /databases/$(database)/documents/pinResets/$(memberId); }

    function signedIn() { return request.auth != null; }
    function myId() { return exists(linkPath()) ? get(linkPath()).data.memberId : request.auth.uid; }
    function me() { return get(userPath(myId())).data; }
    // Signed in with the account currently bound to this member (see header).
    function isMe(uid) {
      return signedIn() && myId() == uid && exists(userPath(uid))
        && get(userPath(uid)).data.get('authUid', request.auth.uid) == request.auth.uid;
    }
    function isActive() { return isMe(myId()) && me().status == 'active'; }
    function myRank() { return get(rankPath(me().rankId)).data; }
    function can(p) {
      return isActive() && (myRank().order == 0 || myRank().permissions.get(p, p in defaultOn()) == true);
    }
    // Permissions a rank has unless switched off (see DEFAULT_ON_PERMISSIONS in src/lib/types.ts).
    function defaultOn() { return ['writeLore']; }
    function rankOrder(rankId) { return get(rankPath(rankId)).data.order; }
    // True when rankId sits strictly below the caller in the chain of command.
    function outranks(rankId) {
      return rankId is string && exists(rankPath(rankId)) && myRank().order < rankOrder(rankId);
    }

    // The very first registration seeds ranks + settings in the same batch that
    // creates meta/bootstrap. Only possible while the family has no founder.
    function bootstrapping() {
      return signedIn()
        && !exists(bootstrapPath())
        && getAfter(bootstrapPath()).data.uid == request.auth.uid;
    }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function smallImage(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() < 300000);
    }

    match /meta/bootstrap {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.usernameLower == name;
      // PIN reset bumps the sign-in version so logins use the new account.
      allow update: if signedIn() && !exists(linkPath())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.v == resource.data.get('v', 0) + 1
        && changed().hasOnly(['v'])
        && getAfter(linkPath()).data.memberId == resource.data.uid;
    }

    // One-time PIN reset codes, issued by officers for members below them.
    // Only a SHA-256 hash of the code is stored; nobody can read these docs.
    match /pinResets/{memberId} {
      allow create, update: if can('resetPins') && myId() != memberId
        && exists(userPath(memberId))
        && (get(userPath(memberId)).data.rankId == null || outranks(get(userPath(memberId)).data.rankId))
        && request.resource.data.codeHash is string
        && request.resource.data.by == myId()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h');
      allow delete: if can('resetPins')
        || (signedIn() && getAfter(linkPath()).data.memberId == memberId);
    }

    // Links a post-reset sign-in account to its member. Creating one requires a
    // valid, unexpired reset code for that member, and consumes it.
    match /authLinks/{authUid} {
      allow get: if signedIn() && request.auth.uid == authUid;
      allow create: if signedIn() && request.auth.uid == authUid
        && request.resource.data.keys().hasOnly(['memberId', 'code'])
        && request.resource.data.code is string
        && exists(resetPath(request.resource.data.memberId))
        && hashing.sha256(request.resource.data.code).toHexString().lower()
             == get(resetPath(request.resource.data.memberId)).data.codeHash
        && request.time < get(resetPath(request.resource.data.memberId)).data.expiresAt
        && !existsAfter(resetPath(request.resource.data.memberId))
        && getAfter(userPath(request.resource.data.memberId)).data.authUid == authUid;
    }

    match /users/{uid} {
      allow read: if isActive() || isMe(uid);

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && smallImage('avatar')
        && (
          (request.resource.data.status == 'pending' && request.resource.data.rankId == null)
          || (bootstrapping() && request.resource.data.status == 'active')
        );

      // Members edit their own character sheet.
      allow update: if isMe(uid)
        && changed().hasOnly(['character', 'avatar', 'updatedAt'])
        && smallImage('avatar');

      // PIN reset: a new sign-in account takes over this member. The authLinks
      // create in the same batch is what checks the reset code.
      allow update: if signedIn() && !exists(linkPath())
        && changed().hasOnly(['authUid'])
        && request.resource.data.authUid == request.auth.uid
        && getAfter(linkPath()).data.memberId == uid;

      // Officers approve / promote / demote / suspend members below them.
      allow update: if isActive() && myId() != uid
        && changed().hasOnly(['status', 'rankId', 'reportsTo'])
        && request.resource.data.status in ['pending', 'active', 'suspended']
        && (request.resource.data.rankId == null || outranks(request.resource.data.rankId))
        && (
          (resource.data.status == 'pending' && can('approveMembers'))
          || (can('manageMembers') && (resource.data.rankId == null || outranks(resource.data.rankId)))
        )
        && (request.resource.data.status != 'active' || request.resource.data.rankId != null);
    }

    match /ranks/{rankId} {
      allow read: if isActive();
      allow create: if bootstrapping()
        || (can('manageRanks') && request.resource.data.order > myRank().order);
      allow update: if can('manageRanks') && (
        (resource.data.order > myRank().order && request.resource.data.order > myRank().order)
        // Anyone may rename/recolour their own rank title if they can manage ranks,
        // but never change its order or permissions (prevents self-promotion/lockout).
        || (rankId == me().rankId && changed().hasOnly(['name', 'color']))
      );
      allow delete: if can('manageRanks') && resource.data.order > myRank().order;
    }

    match /settings/branding {
      allow read: if true;
      allow create: if bootstrapping();
      allow update: if can('manageSettings') && smallImage('logo');
    }

    match /settings/family {
      allow read: if isActive();
      allow create: if bootstrapping();
      allow update: if can('manageSettings')
        || (can('postAnnouncements') && changed().hasOnly(['announcement', 'announcementBy', 'announcementAt']));
    }

    // ---- Lore -------------------------------------------------------------
    // Members with writeLore create and edit their own entries; curators
    // (editAllLore) edit or remove anyone's and are the only ones who set canon.

    function str(field, max) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= max;
    }
    function optStr(field, max) { return !(field in request.resource.data) || request.resource.data[field] == null || str(field, max); }
    function memberList(field) { return request.resource.data[field] is list && request.resource.data[field].size() <= 50; }
    function curator() { return can('editAllLore'); }
    function ownsIt() { return resource.data.authorId == myId() && can('writeLore'); }

    match /lore/{id} {
      allow read: if isActive();
      allow create: if can('writeLore')
        && request.resource.data.authorId == myId()
        && (request.resource.data.canon == false || curator())
        && loreValid();
      allow update: if loreValid() && request.resource.data.authorId == resource.data.authorId && (
        curator() || (ownsIt() && request.resource.data.canon == resource.data.canon)
      );
      allow delete: if curator() || ownsIt();

      function loreValid() {
        return str('title', 120) && str('category', 60) && optStr('summary', 400)
          && str('body', 60000) && request.resource.data.canon is bool
          && memberList('characters') && smallImage('thumb');
      }
    }

    match /loreCovers/{id} {
      allow read: if isActive();
      allow create, update: if smallImage('image') && (curator() || (can('writeLore')
          && getAfter(/databases/$(database)/documents/lore/$(id)).data.authorId == myId()));
      allow delete: if curator() || (can('writeLore')
          && get(/databases/$(database)/documents/lore/$(id)).data.authorId == myId());
    }

    match /chronicle/{id} {
      allow read: if isActive();
      allow create: if can('writeLore') && request.resource.data.authorId == myId() && eventValid();
      allow update: if eventValid() && request.resource.data.authorId == resource.data.authorId && (curator() || ownsIt());
      allow delete: if curator() || ownsIt();

      function eventValid() {
        return str('title', 120) && request.resource.data.when.matches('^-?[0-9]{1,6}-[0-9]{2}-[0-9]{2}$')
          && optStr('whenLabel', 80) && optStr('description', 4000) && memberList('characters');
      }
    }

    // In-character journals: any active member writes their own.
    match /journals/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.authorId == myId() && journalValid();
      allow update: if isActive() && resource.data.authorId == myId()
        && request.resource.data.authorId == myId() && journalValid();
      allow delete: if (isActive() && resource.data.authorId == myId()) || curator();

      function journalValid() { return str('title', 120) && str('body', 30000) && optStr('whenLabel', 80); }
    }

    // Ties between characters. A member may only add ties that involve themselves.
    match /relationships/{id} {
      allow read: if isActive();
      allow create: if can('writeLore')
        && request.resource.data.createdBy == myId()
        && request.resource.data.a is string && request.resource.data.b is string
        && request.resource.data.a != request.resource.data.b
        && request.resource.data.type in ['parent', 'sibling', 'spouse', 'sworn', 'mentor', 'ally', 'rival', 'enemy']
        && optStr('note', 200)
        && (myId() in [request.resource.data.a, request.resource.data.b] || curator());
      allow delete: if (isActive() && myId() in [resource.data.a, resource.data.b]) || curator();
    }
  }
}
