rules_version = '2';

// ChosenOps HQ security rules.
// - Everyone signs in with a name + PIN (Firebase email/password behind the scenes).
// - Ranks grant gang-wide permissions; the top rank (order 0) has them all.
// - Officers only act on members and ranks strictly below their own rank.
// - Crew leaders manage their own crew's members, motto, color and emblem.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // After a PIN reset, the sign-in account is linked back to the original member file.
    function myId() {
      return exists(/databases/$(database)/documents/authLinks/$(request.auth.uid))
        ? get(/databases/$(database)/documents/authLinks/$(request.auth.uid)).data.memberId
        : request.auth.uid;
    }
    function memberOf(id) { return get(/databases/$(database)/documents/members/$(id)).data; }
    function me() { return memberOf(myId()); }

    // Signed in with the account currently bound to the member file (a reset retires the old one).
    function bound() {
      let id = myId();
      return signedIn() && exists(/databases/$(database)/documents/members/$(id)) && memberOf(id).get('authUid', id) == request.auth.uid;
    }
    function active() { return bound() && me().status == 'active'; }

    function rankOf(rankId) { return get(/databases/$(database)/documents/hqRanks/$(rankId)).data; }
    function myOrder() { return rankOf(me().rankId).order; }
    // Unranked (pending) members sit below everyone.
    function orderOf(rankId) { return rankId == null ? 1000000 : rankOf(rankId).order; }

    // Owners: set only from GitHub (the 'Set owner' workflow, with the deploy service account),
    // which also makes them admin. They alone hand out admin. Admins: members who entered the
    // admin password or were made admin by an owner. They can do everything except act on the
    // top rank.
    function isOwner() {
      return exists(/databases/$(database)/documents/meta/owners)
        && myId() in get(/databases/$(database)/documents/meta/owners).data.get('ids', []);
    }
    function isAdmin() { return me().get('admin', false) == true; }
    // Roles held on top of rank: their powers are worked out ahead of time on roleHolders/{member}.
    function hasRoles() { return exists(/databases/$(database)/documents/roleHolders/$(myId())); }
    function roles() { return get(/databases/$(database)/documents/roleHolders/$(myId())).data; }
    function roleCan(p) { return hasRoles() && roles().get('perms', {}).get(p, false) == true; }
    function can(p) {
      let r = rankOf(me().rankId);
      return active() && (isAdmin() || r.order == 0 || r.permissions.get(p, false) == true || roleCan(p));
    }
    function below(rankId) { return orderOf(rankId) > (isAdmin() ? 0 : myOrder()); }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function str(v, max) { return v is string && v.size() <= max; }

    function founding() {
      return !exists(/databases/$(database)/documents/meta/hqFounding) && getAfter(/databases/$(database)/documents/meta/hqFounding).data.uid == request.auth.uid;
    }

    match /meta/hqFounding {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    // name key → member id, plus a version that bumps on each PIN reset. Read before sign-in.
    match /names/{key} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'v'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.v == 0
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.nameLower == key;
      // An admin renaming someone adds their new name (the old one keeps signing them in until a PIN reset).
      allow create: if active() && isAdmin() && request.resource.data.keys().hasOnly(['uid', 'v']) && request.resource.data.v == 0
        && getAfter(/databases/$(database)/documents/members/$(request.resource.data.uid)).data.nameLower == key;
      // The PIN-reset flow bumps the version from the new sign-in account.
      allow update: if signedIn() && onlyChanges(['v']) && request.resource.data.v == resource.data.get('v', 0) + 1
        && getAfter(/databases/$(database)/documents/authLinks/$(request.auth.uid)).data.memberId == resource.data.uid;
    }

    function inCrewAfter(id, l, i) {
      return l.size() <= i || id in getAfter(/databases/$(database)/documents/crews/$(l[i])).data.memberIds;
    }
    function crewIdsTrue(id, l) {
      return l is list && l.size() <= 5
        && inCrewAfter(id, l, 0) && inCrewAfter(id, l, 1) && inCrewAfter(id, l, 2) && inCrewAfter(id, l, 3) && inCrewAfter(id, l, 4);
    }

    match /members/{id} {
      allow read: if active() || (bound() && myId() == id);
      // Your own file by sign-in id, even before it exists (so the app can wait for it while signing up).
      allow get: if signedIn() && id == request.auth.uid && resource == null;

      function validNew() {
        let d = request.resource.data;
        return id == request.auth.uid
          && d.keys().hasOnly(['name', 'nameLower', 'status', 'rankId', 'reportsTo', 'joinedAt', 'avatar'])
          && str(d.name, 20) && d.name.size() >= 3 && str(d.nameLower, 20)
          && d.reportsTo == null && d.joinedAt == request.time && d.avatar == null
          && getAfter(/databases/$(database)/documents/names/$(d.nameLower)).data.uid == id;
      }
      allow create: if signedIn() && validNew() && (
        (request.resource.data.status == 'pending' && request.resource.data.rankId == null)
        || (founding() && request.resource.data.status == 'active' && request.resource.data.rankId == 'boss')
      );

      function validProfile() {
        let d = request.resource.data;
        return (!('avatar' in d) || d.avatar == null || str(d.avatar, 200000))
          && (!('alias' in d) || str(d.alias, 30))
          && (!('phone' in d) || str(d.phone, 20))
          && (!('bio' in d) || str(d.bio, 1000))
          && (!('prefs' in d) || (d.prefs is map && d.prefs.size() <= 10))
          && (!('birthday' in d) || d.birthday == null || (d.birthday is string && d.birthday.matches('[01][0-9]-[0-3][0-9]')));
      }

      // Admin access, on its own (only the 'admin' field changes).
      // Becoming an admin with the admin password, written to your own claim in the same go:
      allow update: if request.resource.data.get('admin', false) != resource.data.get('admin', false) && onlyChanges(['admin']) && request.resource.data.admin == true && active() && myId() == id
        && hashing.sha256('chosenops-admin:' + getAfter(/databases/$(database)/documents/adminClaims/$(id)).data.code).toHexString().lower()
           == get(/databases/$(database)/documents/settings/adminKey).data.hash;
      // Stepping down yourself:
      allow update: if request.resource.data.get('admin', false) != resource.data.get('admin', false) && onlyChanges(['admin']) && request.resource.data.admin == false && active() && myId() == id;
      // An owner granting or taking it away:
      allow update: if request.resource.data.get('admin', false) != resource.data.get('admin', false) && onlyChanges(['admin']) && request.resource.data.admin is bool && active() && isOwner();

      // An admin setting their own in-character rank, even stepping down from the top rank (never up into it).
      allow update: if id == myId() && onlyChanges(['rankId']) && resource.data.status == 'active' && request.resource.data.rankId is string
        && active() && isAdmin() && orderOf(request.resource.data.rankId) > 0;
      // An owner setting anyone's rank, the top rank included, so that seat can always be filled.
      allow update: if onlyChanges(['rankId']) && resource.data.status == 'active' && request.resource.data.rankId is string
        && active() && isOwner() && exists(/databases/$(database)/documents/hqRanks/$(request.resource.data.rankId));
      // An admin fixing someone's display name.
      allow update: if request.resource.data.name != resource.data.name && isAdmin() && onlyChanges(['name', 'nameLower'])
        && str(request.resource.data.name, 30) && request.resource.data.name.size() >= 2
        && request.resource.data.nameLower == request.resource.data.name.lower();
      allow update: if
        // Your own profile.
        (onlyChanges(['avatar', 'alias', 'phone', 'bio', 'birthday', 'prefs']) && myId() == id && active() && validProfile())
        // Approving a newcomer into a rank below your own.
        || (resource.data.status == 'pending' && request.resource.data.status == 'active' && onlyChanges(['status', 'rankId'])
            && can('approveMembers') && below(request.resource.data.rankId))
        // Turning a newcomer away.
        || (resource.data.status == 'pending' && request.resource.data.status == 'suspended' && onlyChanges(['status'])
            && can('approveMembers'))
        // Rank, status and chain of command for members below you, into ranks below you.
        // (An admin may also pick their own in-character rank: admin is out-of-character.)
        || (resource.data.status != 'pending' && onlyChanges(['rankId', 'status', 'reportsTo'])
            && can('manageMembers') && (id != myId() || isAdmin()) && below(resource.data.rankId)
            && request.resource.data.rankId is string && below(request.resource.data.rankId)
            && request.resource.data.status in ['active', 'suspended']
            && (request.resource.data.reportsTo == null || request.resource.data.reportsTo is string))
        // The crews someone is in, copied onto their file so pins and events can be shared by crew.
        // Anyone may sync it, but every crew listed must really have them (checked after the write).
        // Crews are retired: a member's old crew list can only be cleared.
        || (onlyChanges(['crewIds']) && request.resource.data.crewIds == [] && active())
        // PIN reset: the new sign-in account claims the member file (code checked on authLinks).
        || (onlyChanges(['authUid']) && signedIn() && request.resource.data.authUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/authLinks/$(request.auth.uid)).data.memberId == id);
    }

    // Owners only: wiping a test account or the old half of a merged one.
    match /members/{id} {
      allow delete: if active() && isOwner() && id != myId();
    }

    // Online check-ins and custom statuses. Each member writes only their own.
    match /presence/{id} {
      allow read: if active();
      allow write: if active() && myId() == id
        && request.resource.data.keys().hasOnly(['at', 'status'])
        && request.resource.data.at == request.time
        && (!('status' in request.resource.data) || str(request.resource.data.status, 24));
    }

    match /hqRanks/{rankId} {
      allow read: if active();
      allow create: if (founding() && request.resource.data.order is int)
        || (can('manageRanks') && request.resource.data.order > myOrder());
      allow update: if can('manageRanks') && below(rankId) && request.resource.data.order > myOrder();
      allow delete: if can('manageRanks') && below(rankId);
    }

    match /crews/{crewId} {
      allow read: if active();

      function validCrew() {
        let d = request.resource.data;
        return str(d.name, 30) && d.name.size() > 0 && str(d.tag, 4) && d.tag.size() > 0
          && str(d.color, 9) && d.memberIds is list && d.memberIds.size() <= 200
          && (!('motto' in d) || str(d.motto, 80))
          && (!('emblem' in d) || d.emblem == null || str(d.emblem, 200000))
          && (d.leaderId == null || d.leaderId in d.memberIds);
      }
      allow create, update: if can('manageCrews') && validCrew();
      allow delete: if can('manageCrews');
      // Crew leaders run their own roster and look; the leader stays in the crew.
      allow update: if active() && resource.data.leaderId == myId() && validCrew()
        && onlyChanges(['memberIds', 'motto', 'color', 'emblem'])
        && myId() in request.resource.data.memberIds;
    }

    // Who owns the HQ. Written only from GitHub; an owner can see their own entry, nobody else.
    match /meta/owners {
      allow get: if signedIn() && myId() in resource.data.get('ids', []);
      allow write: if false;
    }
    // The admin password, stored as a hash. Nobody reads it; only owners set it.
    match /settings/adminKey {
      allow read: if false;
      allow write: if active() && isOwner()
        && request.resource.data.keys().hasOnly(['hash', 'by', 'at'])
        && request.resource.data.hash is string && request.resource.data.hash.size() == 64
        && request.resource.data.by == myId();
    }
    // What a member typed as the admin password (checked by the members rule above).
    match /adminClaims/{uid} {
      allow read: if false;
      allow write: if active() && myId() == uid && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 100;
    }

    match /settings/gang {
      allow read: if active();
      allow create: if founding();
      allow update: if can('manageSettings') && str(request.resource.data.name, 40) && str(request.resource.data.motto, 80);
    }
    match /settings/announcement {
      allow read: if active();
      allow create: if founding() || can('postAnnouncements');
      allow update: if can('postAnnouncements') && str(request.resource.data.text, 500)
        && request.resource.data.by == myId() && request.resource.data.at == request.time;
    }

    // ── Ops: Narcotics and Stash ─────────────────────────────────
    // A page opens through your rank, or through a crew whose role grants it. Every ops write is
    // signed with _by (you) and _via ('rank' or that crew's id), and the rules check the claim.
    function rankPage(page) {
      let r = rankOf(me().rankId);
      return isAdmin() || r.order == 0 || r.get('pages', {}).get(page, false) == true;
    }
    function crewPage(page, crewId) {
      let c = get(/databases/$(database)/documents/crews/$(crewId)).data;
      return myId() in c.memberIds && c.get('pages', {}).get(page, false) == true;
    }
    function opens(page) {
      let v = request.resource.data.get('_via', null);
      return active() && request.resource.data.get('_by', null) == myId()
        && ((v == 'rank' && rankPage(page))
          || (v == 'role' && hasRoles() && roles().get('pages', {}).get(page, false) == true)
          || (v is string && v != 'rank' && exists(/databases/$(database)/documents/crews/$(v)) && crewPage(page, v)));
    }
    function opsWrite() { return opens('narcotics') || opens('stash') || opens('blackmarket'); }

    match /locations/{locId} {
      allow read: if active();
      // Anyone working the ops runs timers, pot plans and the totals switch.
      allow update: if opsWrite()
        && onlyChanges(['startTime', 'alertSent', 'strainPots', 'pots', 'excludeTotals', '_by', '_via']);
      // Leadership (or Manage ops) adds, renames and removes any place. The Main Stash stays.
      allow create, update: if (can('manageOps') || lead()) && request.resource.data.kind in ['stash', 'grow']
        && str(request.resource.data.name, 40);
      // Anyone can start a gang stash house; they own it, and leadership runs it from then on.
      allow create: if active() && request.resource.data.kind == 'stash' && str(request.resource.data.name, 40)
        && request.resource.data.createdBy == myId() && request.resource.data.owners == [myId()];
      // Owners change their stash's settings, but never who owns it.
      allow update: if active() && myId() in resource.data.get('owners', [])
        && request.resource.data.get('owners', []) == resource.data.get('owners', [])
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.kind == 'stash' && str(request.resource.data.get('name', 'x'), 40);
      allow delete: if (can('manageOps') || lead()) && locId != 'main';
    }

    // Taking from (or adding to) a stash house needs its take rank, unless you own it or lead.
    function canTakeAt(locId) {
      let l = /databases/$(database)/documents/locations/$(locId);
      return !exists(l) || get(l).data.get('takeRank', null) == null
        || myOrder() <= orderOf(get(l).data.takeRank)
        || myId() in get(l).data.get('owners', []) || lead() || isAdmin();
    }
    match /stock/{locId} {
      allow read: if active();
      allow create, update: if opsWrite() && canTakeAt(locId);
      allow delete: if can('manageOps') && locId != 'main';
    }

    match /cooks/{id} {
      allow read: if active();
      allow create, update: if opens('narcotics');
    }
    match /runs/{id} {
      allow read: if active();
      allow create, update: if opens('narcotics');
    }
    match /supplies/lab {
      allow read: if active();
      allow create, update: if opens('narcotics');
    }
    match /yields/{strain} {
      allow read: if active();
      allow create, update: if opens('narcotics');
    }
    match /history/{day} {
      allow read: if active();
      allow create, update: if opsWrite();
    }
    match /activity/{id} {
      allow read: if active();
      allow create: if opsWrite() && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['who', 'kind', 'pre', 'hi', 'post', 'at', '_by', '_via']);
    }
    // The item catalog: guns, attachments, ammo, gear and anything else. Anyone can add a
    // new item when they need it; Manage ops edits, removes and bulk-imports.
    match /itemTypes/{id} {
      allow read: if active();
      // Custom names (a member's own variant of an item) carry their owner.
      allow create: if active() && str(request.resource.data.name, 40) && request.resource.data.name.size() > 0
        && request.resource.data.get('owner', myId()) == myId();
      allow update, delete: if can('manageOps');
      allow update: if active() && resource.data.get('owner', '') == myId() && onlyChanges(['name'])
        && str(request.resource.data.name, 40) && request.resource.data.name.size() > 0;
    }
    match /settings/narcotics {
      allow read: if active();
      allow create, update: if can('manageOps');
    }

    // ── My Locker: private to each member ───────────────────────
    function mine(field) { return request.resource.data[field] == myId(); }
    function wasMine(field) { return resource.data[field] == myId(); }

    // Character sheets: anyone in the family reads them; only the member writes their own.
    match /sheets/{memberId} {
      allow read: if active();
      allow write: if active() && myId() == memberId
        && request.resource.data.keys().hasOnly(['basics', 'looks', 'city', 'story', 'traits', 'skills', 'customSkills', 'customFields', 'relations', 'song', 'wanted', 'star'])
        && request.resource.data.get('star', 'gold') in ['gold', 'white', 'ice', 'rose', 'ember', 'emerald', 'violet', 'crimson']
        && (!('traits' in request.resource.data) || request.resource.data.traits.size() <= 16)
        && (!('relations' in request.resource.data) || request.resource.data.relations.size() <= 24)
        && (!('customFields' in request.resource.data) || request.resource.data.customFields.size() <= 16)
        && (!('customSkills' in request.resource.data) || request.resource.data.customSkills.size() <= 12)
        && (!('song' in request.resource.data) || str(request.resource.data.song, 300));
    }
    // Journal entries are private unless shared. Shared ones can get one emoji reaction per member.
    match /journal/{id} {
      allow read: if active() && (resource.data.memberId == myId() || resource.data.public == true);
      allow create: if active() && mine('memberId') && request.resource.data.at == request.time
        && str(request.resource.data.title, 80) && str(request.resource.data.text, 4000) && request.resource.data.public is bool
        && request.resource.data.reactions == {};
      allow update: if active() && wasMine('memberId') && onlyChanges(['title', 'text', 'public'])
        && str(request.resource.data.title, 80) && str(request.resource.data.text, 4000) && request.resource.data.public is bool;
      allow update: if active() && resource.data.public == true && onlyChanges(['reactions'])
        && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([myId()]);
      allow delete: if active() && wasMine('memberId');
    }
    // Leadership notes on a member: the member can read their own; leadership writes them.
    match /leaderNotes/{id} {
      allow read: if active() && (resource.data.memberId == myId() || can('manageMembers'));
      allow create: if can('manageMembers') && mine('by') && request.resource.data.memberId != myId()
        && request.resource.data.at == request.time && str(request.resource.data.text, 300)
        && request.resource.data.kind in ['commendation', 'note', 'warning', 'strike'];
      allow delete: if can('manageMembers');
    }

    // Daily login streaks. The member counts their own days; only an admin sets leave (LOA).
    match /streaks/{memberId} {
      allow read: if active();
      allow create, update: if active() && myId() == memberId
        && request.resource.data.keys().hasOnly(['current', 'best', 'last', 'freezes', 'loaFrom', 'loaUntil', 'at'])
        && request.resource.data.current is int && request.resource.data.best is int
        && request.resource.data.best >= request.resource.data.current
        && request.resource.data.at == request.time
        && request.resource.data.get('loaFrom', null) == (resource == null ? null : resource.data.get('loaFrom', null))
        && request.resource.data.get('loaUntil', null) == (resource == null ? null : resource.data.get('loaUntil', null));
      allow update: if isAdmin() && onlyChanges(['loaFrom', 'loaUntil']);
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['loaFrom', 'loaUntil']);
      // Admin fix: set the numbers straight.
      allow create, update: if active() && isAdmin()
        && request.resource.data.keys().hasOnly(['current', 'best', 'last', 'freezes', 'loaFrom', 'loaUntil', 'at'])
        && request.resource.data.current is int && request.resource.data.best is int
        && request.resource.data.current >= 0 && request.resource.data.best >= request.resource.data.current;
    }
    // Today's spotlight, when leadership picks someone.
    match /spotlight/{id} {
      allow read: if active();
      allow write: if can('manageMembers') && request.resource.data.keys().hasOnly(['memberId', 'why', 'day', 'by'])
        && str(request.resource.data.get('why', ''), 140);
    }
    // Family news for the briefing: who joined, who got promoted.
    match /news/{id} {
      allow read: if active();
      allow create: if (can('approveMembers') || can('manageMembers')) && request.resource.data.at == request.time
        && request.resource.data.kind in ['joined', 'promoted'];
    }

    // Hall of Fame: leadership's MVP of the month and legend plaques.
    match /monthMvp/{ym} {
      allow read: if active();
      allow write: if (can('manageMembers') || can('hallOfFame')) && ym.matches('[0-9]{4}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['memberId', 'why', 'by']) && str(request.resource.data.why, 140);
    }
    // Past members: deceased, retired, moved on or exiled. Exiled ones only leadership can read.
    // (Leaving the roster is the member's status going to 'suspended', set alongside.)
    match /pastMembers/{memberId} {
      allow read: if active() && (resource.data.kind != 'exiled' || (can('manageMembers') || can('hallOfFame')));
      allow write: if (can('manageMembers') || can('hallOfFame')) && memberId != myId()
        && below(get(/databases/$(database)/documents/members/$(memberId)).data.rankId)
        && (request.resource == null || (request.resource.data.kind in ['deceased', 'retired', 'moved', 'exiled']
            && str(request.resource.data.epitaph, 200) && request.resource.data.day is string));
    }
    match /legends/{id} {
      allow read: if active();
      allow create: if (can('manageMembers') || can('hallOfFame')) && request.resource.data.at == request.time
        && str(request.resource.data.title, 60) && str(request.resource.data.text, 400);
      allow delete: if (can('manageMembers') || can('hallOfFame'));
    }
    // Paying respects to past members: one candle per member, and short memories.
    match /tributes/{memberId} {
      allow read: if active();
      allow create: if active() && request.resource.data.keys().hasOnly(['candles'])
        && request.resource.data.candles.keys().hasOnly([myId()]);
      allow update: if active() && onlyChanges(['candles'])
        && request.resource.data.candles.diff(resource.data.get('candles', {})).affectedKeys().hasOnly([myId()]);
      match /memories/{mid} {
        allow read: if active();
        allow create: if active() && mine('by') && request.resource.data.at == request.time && str(request.resource.data.text, 140);
        allow delete: if active() && (wasMine('by') || can('manageMembers'));
      }
    }

    match /lockers/{memberId} {
      allow read, write: if active() && myId() == memberId;
    }
    // One doc per storage: "<memberId>__<storageId>". Same shape as a stash's stock.
    match /lockerStock/{id} {
      // An empty storage has no doc yet; reading it (before the first thing goes in) is fine if it's yours.
      allow read: if active() && (resource == null ? id.matches(myId() + '__.+') : wasMine('owner'));
      allow create: if active() && mine('owner') && id.matches(myId() + '__.+');
      allow update: if active() && wasMine('owner') && mine('owner');
      allow delete: if active() && wasMine('owner');
    }
    // Gang property taken into a locker. The member and leadership see these.
    match /signouts/{id} {
      allow read: if active() && (wasMine('memberId') || can('money') || can('manageOps') || lead() || isAdmin());
      allow create: if active() && mine('memberId') && request.resource.data.status == 'out' && request.resource.data.at == request.time;
      allow update: if active() && onlyChanges(['status', 'closedAt', 'closedBy'])
        && request.resource.data.status in ['returned', 'lost', 'seized'] && resource.data.status == 'out'
        && (wasMine('memberId') || can('manageOps') || lead());
    }
    // Member-to-member trades. The giver's items are held until the other person accepts.
    match /trades/{id} {
      allow read: if active() && (wasMine('from') || wasMine('to'));
      allow create: if active() && mine('from') && request.resource.data.to != myId()
        && request.resource.data.status == 'pending' && request.resource.data.at == request.time;
      allow update: if active() && (
        // One-item trades (the first version).
        (onlyChanges(['status', 'closedAt']) && (
          (wasMine('to') && resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'declined'])
          || (wasMine('from') && resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
          || (wasMine('from') && resource.data.status == 'declined' && request.resource.data.status == 'returned')))
        // The other side answers an offer: accept as is, counter, or decline.
        || (wasMine('to') && resource.data.status == 'pending'
            && onlyChanges(['status', 'closedAt', 'reply', 'toCollected', 'back', 'backCash', 'backStorage'])
            && request.resource.data.status in ['done', 'countered', 'declined'])
        // The sender answers a counter.
        || (wasMine('from') && resource.data.status == 'countered' && onlyChanges(['status', 'closedAt', 'fromCollected'])
            && request.resource.data.status in ['done', 'declined'])
        // Picking up what's yours, or getting your own things back.
        || (wasMine('to') && resource.data.status in ['done', 'declined'] && onlyChanges(['toCollected', 'backReturned']))
        || (wasMine('from') && resource.data.status in ['done', 'declined', 'cancelled'] && onlyChanges(['fromCollected', 'giveReturned'])));
    }
    // Cash members add to or take out of their own locker (city money, not gang sales).
    match /myCash/{id} {
      allow read: if active() && (wasMine('memberId') || can('money'));
      allow create: if active() && (mine('memberId') || isAdmin() || can('money')) && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['memberId', 'dirty', 'clean', 'note', 'at'])
        && request.resource.data.dirty is int && request.resource.data.clean is int
        && str(request.resource.data.get('note', ''), 60);
      allow delete: if active() && (wasMine('memberId') || can('money'));
    }
    // Money that changed hands in a finished trade (one per direction), checked against the trade.
    match /cashMoves/{id} {
      allow read: if active() && (wasMine('from') || wasMine('to') || can('money'));
      allow create: if active() && request.resource.data.at == request.time
        && (myId() == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.from
            || myId() == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.to)
        && get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.status == 'done'
        && ((id == request.resource.data.tradeId + '_give'
              && request.resource.data.from == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.from
              && request.resource.data.to == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.to
              && request.resource.data.dirty == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.cash.dirty
              && request.resource.data.clean == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.cash.clean)
          || (id == request.resource.data.tradeId + '_back'
              && request.resource.data.from == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.to
              && request.resource.data.to == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.from
              && request.resource.data.dirty == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.backCash.dirty
              && request.resource.data.clean == get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.backCash.clean));
    }

    // ── Keepsake cabinet and trophies (on profiles) ─────────────
    match /cabinets/{memberId} {
      allow read: if active();
      allow write: if active() && myId() == memberId;
    }
    // Trophies come two ways: earned from achievements (the member's own page awards them once,
    // with a fixed id per achievement tier so they can't stack), or awarded by leadership.
    match /trophies/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.at == request.time && str(request.resource.data.title, 60)
        && ((request.resource.data.kind == 'award' && can('awardTrophies') && mine('by'))
          || (request.resource.data.kind == 'achievement' && mine('memberId') && request.resource.data.by == 'achievement'
              && id == myId() + '_' + request.resource.data.achId + '_' + string(request.resource.data.tier))
          // Top 3 of a finished month on a leaderboard, handed out by whoever opens the boards first.
          || (request.resource.data.kind == 'monthly' && request.resource.data.by == 'leaderboard'
              && request.resource.data.board in ['sales', 'bricks'] && request.resource.data.month is string
              && monthOver(request.resource.data.month)
              && request.resource.data.tier in [1, 2, 3]
              && request.resource.data.get('place', 0) == 4 - request.resource.data.tier
              && request.resource.data.memberId in get(/databases/$(database)/documents/boards/$(request.resource.data.month)).data.get(request.resource.data.board, {})
              && id == request.resource.data.memberId + '_top_' + request.resource.data.board + '_' + request.resource.data.month));
      allow delete: if active() && can('awardTrophies');
    }
    // Each member's own work counters (harvests, presses, cooks, runs) for achievements.
    match /stats/{memberId} {
      allow read: if active();
      allow write: if active() && (myId() == memberId || (isAdmin() && memberId != 'familyRep'));
    }

    // ── BlackMarket: drugs sell for dirty money ─────────────────
    match /sales/{id} {
      // Narco logs are public to the family (personal amounts are hidden on screen).
      allow read: if active();
      allow create: if opens('blackmarket') && request.resource.data.at == request.time
        && (mine('sellerId') || can('money'))
        && request.resource.data.qty is int && request.resource.data.qty > 0;
      allow delete: if can('money');
    }
    match /washes/{id} {
      allow read: if active() && (can('money') || wasMine('memberId'));
      allow create: if active() && request.resource.data.at == request.time
        && ((mine('memberId') && opens('blackmarket')) || can('money'));
      allow delete: if can('money');
    }
    // The leader of a Narco call paying someone who came along: out of the sale, or their own pocket.
    match /teamPays/{id} {
      allow read: if active() && (wasMine('from') || wasMine('to') || can('money'));
      allow create: if active() && mine('from') && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['callId', 'saleId', 'from', 'to', 'dirty', 'source', 'fromBank', 'at'])
        && request.resource.data.dirty is int && request.resource.data.dirty > 0
        && request.resource.data.fromBank is int && request.resource.data.fromBank >= 0
        && request.resource.data.fromBank <= request.resource.data.dirty
        && request.resource.data.source in ['sale', 'mine']
        && (request.resource.data.source == 'sale' || request.resource.data.fromBank == 0)
        && get(/databases/$(database)/documents/sales/$(request.resource.data.saleId)).data.sellerId == myId()
        && get(/databases/$(database)/documents/sales/$(request.resource.data.saleId)).data.callId == request.resource.data.callId
        && request.resource.data.to in get(/databases/$(database)/documents/sales/$(request.resource.data.saleId)).data.get('team', []);
      allow delete: if active() && (wasMine('from') || can('money'));
    }
    // Wash requests: a member sends dirty money; a washer claims it and marks it done.
    match /washRequests/{id} {
      allow read: if active() && (wasMine('memberId') || can('washMoney') || can('money'));
      // A member's own wash, or the Treasurer sending the gang's dirty money (memberId 'gang').
      allow create: if active() && (mine('memberId') || (request.resource.data.memberId == 'gang' && can('money'))) && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['memberId', 'memberName', 'dirty', 'pct', 'clean', 'status', 'claimerId', 'claimerName', 'note', 'at'])
        && request.resource.data.status == 'open' && request.resource.data.claimerId == null
        && request.resource.data.dirty is int && request.resource.data.dirty > 0
        && request.resource.data.pct is int && request.resource.data.pct >= 0 && request.resource.data.pct <= 100
        && request.resource.data.clean is int && request.resource.data.clean >= 0 && request.resource.data.clean <= request.resource.data.dirty;
      // Cheap field checks first, then the washer power (it costs reads).
      allow update: if active() && (
        // A washer claims an open one, lets go of their own, or finishes their own.
        (resource.data.status == 'open' && request.resource.data.status == 'claimed' && request.resource.data.claimerId == myId()
          && onlyChanges(['status', 'claimerId', 'claimerName']) && can('washMoney'))
        || (resource.data.status == 'claimed' && request.resource.data.status == 'open' && request.resource.data.claimerId == null
          && resource.data.claimerId == myId() && onlyChanges(['status', 'claimerId', 'claimerName', 'timerMins', 'timerEnd']) && can('washMoney'))
        || (resource.data.status == 'claimed' && request.resource.data.status == 'done' && resource.data.claimerId == myId()
          && request.resource.data.doneAt == request.time && onlyChanges(['status', 'doneAt']) && can('washMoney'))
        // The washer sets (or clears) a timer on the machine for a wash they've claimed.
        || (resource.data.status == 'claimed' && resource.data.claimerId == myId() && onlyChanges(['timerEnd', 'timerMins'])
          && (request.resource.data.timerMins == null || (request.resource.data.timerMins is int && request.resource.data.timerMins > 0 && request.resource.data.timerMins <= 240))
          && can('washMoney'))
        // The member cancels one nobody has claimed yet (the Treasurer, for the gang's).
        || (resource.data.status == 'open' && request.resource.data.status == 'cancelled' && request.resource.data.doneAt == request.time
          && onlyChanges(['status', 'doneAt']) && (wasMine('memberId') || (resource.data.memberId == 'gang' && can('money')))));
    }
    // Payouts and expenses. A member can see payouts made to them.
    match /ledger/{id} {
      allow read: if active() && (can('money') || resource.data.get('toId', null) == myId());
      allow create, delete: if can('money');
    }
    match /wishes/{id} {
      allow read: if active();
      allow create: if active() && mine('byId') && request.resource.data.status == 'open';
      allow update: if active();
    }
    match /settings/blackmarket {
      allow read: if active();
      allow write: if can('money');
    }

    // ── Petty crime ──────────────────────────────────────────────
    function transfer(tid) { return get(/databases/$(database)/documents/repTransfers/$(tid)).data; }
    function transferAfter(tid) { return getAfter(/databases/$(database)/documents/repTransfers/$(tid)).data; }

    // Each member's own petty rep. Self-reported, so members set their own (never below zero).
    // A confirmer may only add back the exact amount of a transfer they're rejecting.
    match /petty/{id} {
      allow read: if active();
      // Admin fix of someone's rep total.
      allow create, update: if active() && isAdmin()
        && request.resource.data.keys().hasOnly(['rep', 'refundOf'])
        && request.resource.data.rep is int && request.resource.data.rep >= 0;
      allow create, update: if active() && myId() == id
        && request.resource.data.keys().hasOnly(['rep', 'refundOf'])
        && request.resource.data.rep is int && request.resource.data.rep >= 0
        && (resource == null || request.resource.data.get('refundOf', null) == resource.data.get('refundOf', null));
      allow create, update: if can('confirmRep')
        && request.resource.data.keys().hasOnly(['rep', 'refundOf'])
        && transfer(request.resource.data.refundOf).memberId == id
        && transfer(request.resource.data.refundOf).status == 'pending'
        && transferAfter(request.resource.data.refundOf).status == 'rejected'
        && request.resource.data.rep
           == (resource == null ? 0 : resource.data.rep) + transfer(request.resource.data.refundOf).amount;
    }

    match /pettyLog/{logId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['memberId', 'crime', 'crimes', 'perJob', 'rep', 'cash', 'cashId', 'notes', 'at'])
        && request.resource.data.memberId == myId() && request.resource.data.at == request.time
        && str(request.resource.data.crime, 80) && str(request.resource.data.notes, 140)
        && request.resource.data.get('crimes', {}) is map && request.resource.data.get('crimes', {}).size() <= 20
        && request.resource.data.get('perJob', []) is list && request.resource.data.get('perJob', []).size() <= 50
        && request.resource.data.rep is int && request.resource.data.rep >= 0 && request.resource.data.rep <= 1000000
        && request.resource.data.cash is int && request.resource.data.cash >= 0;
      allow delete: if active() && (resource.data.memberId == myId() || can('confirmRep'));
    }

    // Each member's own weekly petty rep goal.
    match /pettyGoals/{memberId} {
      allow read: if active();
      allow write: if active() && myId() == memberId
        && request.resource.data.keys().hasOnly(['weekly']) && request.resource.data.weekly is int
        && request.resource.data.weekly >= 0 && request.resource.data.weekly <= 10000000;
    }
    // The family's petty rep goal, set by leadership.
    match /settings/pettyGoal {
      allow read: if active();
      allow write: if (lead() || can('confirmRep'))
        && request.resource.data.keys().hasOnly(['title', 'target', 'by', 'from'])
        && str(request.resource.data.title, 60) && request.resource.data.target is int && str(request.resource.data.by, 10);
    }
    // Rep a member sends to the family, confirmed (or turned down) by Lieutenant+.
    match /repTransfers/{tid} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['memberId', 'amount', 'status', 'at', 'dues'])
        && str(request.resource.data.get('dues', ''), 10)
        && request.resource.data.memberId == myId() && request.resource.data.status == 'pending'
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.at == request.time;
      // Nobody confirms their own, except the top rank. Confirming must add it to the family
      // total in the same write; rejecting must give it back to the member.
      allow update: if can('confirmRep') && resource.data.status == 'pending'
        && (resource.data.memberId != myId() || myOrder() == 0)
        && onlyChanges(['status', 'decidedBy', 'decidedAt'])
        && request.resource.data.decidedBy == myId() && request.resource.data.decidedAt == request.time
        && (
          (request.resource.data.status == 'confirmed'
            && getAfter(/databases/$(database)/documents/stats/familyRep).data.lastTransfer == tid)
          || (request.resource.data.status == 'rejected'
            && getAfter(/databases/$(database)/documents/petty/$(resource.data.memberId)).data.get('refundOf', null) == tid)
        );
    }

    // The family's gang rep. Grows by exactly the amount of each confirmed transfer.
    match /stats/familyRep {
      allow read: if active();
      allow create, update: if can('confirmRep')
        && request.resource.data.keys().hasOnly(['total', 'lastTransfer', 'lastBlacksite'])
        && request.resource.data.get('lastBlacksite', null) == (resource == null ? null : resource.data.get('lastBlacksite', null))
        && transfer(request.resource.data.lastTransfer).status == 'pending'
        && transferAfter(request.resource.data.lastTransfer).status == 'confirmed'
        && request.resource.data.total
           == (resource == null ? 0 : resource.data.total) + transfer(request.resource.data.lastTransfer).amount;
      // A blacksite's rep, added once, when Lieutenant+ confirms the fight.
      allow create, update: if can('confirmRep')
        && request.resource.data.keys().hasOnly(['total', 'lastTransfer', 'lastBlacksite'])
        && request.resource.data.get('lastTransfer', null) == (resource == null ? null : resource.data.get('lastTransfer', null))
        && site(request.resource.data.lastBlacksite).repStatus == 'pending'
        && siteAfter(request.resource.data.lastBlacksite).repStatus == 'confirmed'
        && request.resource.data.total
           == (resource == null ? 0 : resource.data.total) + site(request.resource.data.lastBlacksite).rep
              - (site(request.resource.data.lastBlacksite).get('calledIn', false) == true ? 150 : 0);
      // Leadership can correct the total by hand.
      allow create, update: if can('manageSettings') && request.resource.data.total is int
        && request.resource.data.keys().hasOnly(['total', 'lastTransfer', 'lastBlacksite']);
    }

    // ── Blacksites: King of the Hill fights ─────────────────────
    function site(id) { return get(/databases/$(database)/documents/blacksites/$(id)).data; }
    function siteAfter(id) { return getAfter(/databases/$(database)/documents/blacksites/$(id)).data; }
    function mapOnlyMine(after, before) {
      return after.diff(before).affectedKeys().hasOnly([myId()]);
    }
    match /blacksites/{bid} {
      allow read: if active();
      function validSite() {
        let d = request.resource.data;
        return str(d.zone, 60) && d.zone.size() > 0 && d.at is timestamp
          && d.result in ['win', 'loss', 'draw'] && d.rivals is list && d.rivals.size() <= 10
          && d.holdMins is int && d.holdMins >= 0 && d.rep is int && d.rep >= 0 && d.rep <= 1000000
          && d.participants is list && d.participants.size() <= 60
          && d.stats is map && d.stats.keys().hasOnly(d.participants)
          && d.votes is map && (!('notes' in d) || str(d.notes, 1000))
          && d.lootStatus in ['open', 'closed'] && str(d.stashTo, 60)
          && d.get('calledIn', false) is bool;
      }
      // Anyone logs a fight. Its rep waits for Lieutenant+.
      allow create: if active() && validSite() && request.resource.data.loggedBy == myId()
        && request.resource.data.repStatus == 'pending' && request.resource.data.lootStatus == 'open'
        && request.resource.data.votes.size() == 0;
      allow update: if active() && (
        // The logger fixes anything except the rep decision (and can't change the rep once confirmed).
        (resource.data.loggedBy == myId() && validSite()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['repStatus', 'repBy', 'loggedBy', 'votes'])
          && (resource.data.repStatus == 'pending' || request.resource.data.rep == resource.data.rep))
        // Each participant fills in their own line and casts their own MVP vote (for someone else who was there).
        || (myId() in resource.data.participants && onlyChanges(['stats', 'votes'])
            && mapOnlyMine(request.resource.data.stats, resource.data.stats)
            && mapOnlyMine(request.resource.data.votes, resource.data.votes)
            && (!(myId() in request.resource.data.votes)
                || (request.resource.data.votes[myId()] in resource.data.participants && request.resource.data.votes[myId()] != myId())))
        // Lieutenant+ confirms (adding it to the family total in the same write) or turns down the rep.
        || (can('confirmRep') && resource.data.repStatus == 'pending' && onlyChanges(['repStatus', 'repBy'])
            && request.resource.data.repBy == myId()
            && ((request.resource.data.repStatus == 'confirmed'
                  && getAfter(/databases/$(database)/documents/stats/familyRep).data.lastBlacksite == bid)
                || request.resource.data.repStatus == 'rejected'))
        // Leadership tidies locations: moves a fight to another location.
        || ((lead() || can('manageOps')) && onlyChanges(['spotId', 'zone']) && str(request.resource.data.zone, 60))
        // Closing the loot draw (the leftovers then go into the stash).
        || (resource.data.lootStatus == 'open' && onlyChanges(['lootStatus', 'closedBy'])
            && request.resource.data.lootStatus == 'closed' && request.resource.data.closedBy == myId()
            && (resource.data.loggedBy == myId() || resource.data.get('closesAt', request.time) < request.time || can('manageOps') || lead()))
      );
      allow delete: if active() && (can('manageOps') || (resource.data.loggedBy == myId() && resource.data.repStatus == 'pending'));

      // Loot to share out: participants claim, the rest goes into the stash when the draw closes.
      match /loot/{lid} {
        allow read: if active();
        allow create: if active() && site(bid).loggedBy == myId() && site(bid).lootStatus == 'open'
          && str(request.resource.data.label, 60) && request.resource.data.qty is int && request.resource.data.qty > 0
          && request.resource.data.claims is map && request.resource.data.claims.size() == 0;
        allow update: if active() && (
          // Leadership splits the pile.
          ((lead() || can('manageOps')) && site(bid).lootStatus == 'open' && onlyChanges(['qty', 'assigned'])
            && request.resource.data.qty is int && request.resource.data.qty >= 0 && request.resource.data.qty <= resource.data.qty)
          // A fighter marks what they were given as collected.
          || (onlyChanges(['collected']) && mapOnlyMine(request.resource.data.collected, resource.data.get('collected', {}))
            && request.resource.data.collected[myId()] <= resource.data.get('assigned', {}).get(myId(), 0))
          || (site(bid).lootStatus == 'open' && myId() in site(bid).participants
            && onlyChanges(['qty', 'claims']) && mapOnlyMine(request.resource.data.claims, resource.data.claims)
            && request.resource.data.qty >= 0
            && request.resource.data.qty - resource.data.qty
               == resource.data.claims.get(myId(), 0) - request.resource.data.claims.get(myId(), 0))
          || (site(bid).lootStatus == 'closed' && onlyChanges(['qty', 'dumped'])
              && request.resource.data.qty == 0 && request.resource.data.dumped == true)
        );
        allow delete: if active() && site(bid).loggedBy == myId() && resource.data.claims.size() == 0;
      }
      // Loot screenshots, one per doc (they're big).
      match /photos/{pid} {
        allow read: if active();
        allow create: if active() && (site(bid).loggedBy == myId() || myId() in site(bid).participants)
          && request.resource.data.by == myId() && str(request.resource.data.image, 400000);
        allow delete: if active() && (resource.data.by == myId() || site(bid).loggedBy == myId());
      }
    }

    // Every move in and out of the stashes. Anyone writes their own; only admins read it.
    match /stashLog/{id} {
      allow read: if isAdmin();
      allow create: if active() && request.resource.data.by == myId() && request.resource.data.at == request.time
        && request.resource.data.qty is int && str(request.resource.data.label, 60);
    }
    // What every stash held at the start of each day (the first visitor writes it). Admins read and prune.
    match /stashSnaps/{day} {
      allow read, delete: if isAdmin();
      allow create: if active() && request.resource.data.day == day && request.resource.data.counts is map;
    }
    // "Please bring it back" reminders from leadership or a stash's owners.
    match /nudges/{id} {
      allow read: if active() && (wasMine('to') || wasMine('from'));
      allow create: if active() && mine('from') && request.resource.data.at == request.time && str(request.resource.data.text, 120);
      allow delete: if active() && (wasMine('to') || wasMine('from'));
    }

    // Blacksite locations. Anyone adds one by logging a fight there; leadership places, edits and merges them.
    match /blacksiteSpots/{id} {
      allow read: if active();
      allow create: if active() && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0 && request.resource.data.by == myId();
      allow update: if (lead() || can('manageOps')) && str(request.resource.data.name, 60) && str(request.resource.data.get('notes', ''), 1000);
      allow delete: if lead() || can('manageOps');
    }

    // ── Leaderboards: one doc per month (ET), e.g. boards/2026-10 ──
    // sales: dirty $ per seller, bricks: bricks pressed per member. Kept forever for the Hall of Fame.
    function boardMap(d, k) { return d == null ? {} : d.get(k, {}); }
    function boardChange(k) {
      return request.resource.data.get(k, {}).diff(boardMap(resource == null ? null : resource.data, k)).affectedKeys();
    }
    // A sale's dirty money per day, for the Dashboard's daily briefing.
    match /daily/{day} {
      allow read: if active();
      allow create, update: if active() && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['sales', '_by', '_via'])
        && (opens('blackmarket') || can('money'));
    }

    match /boards/{ym} {
      allow read: if active();
      allow create, update: if active() && ym.matches('[0-9]{4}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['sales', 'bricks', 'awarded', '_by', '_via'])
        && boardChange('bricks').hasOnly([myId()])
        && (boardChange('sales').size() == 0 || opens('blackmarket') || can('money'))
        && (request.resource.data.get('awarded', false) == (resource == null ? false : resource.data.get('awarded', false))
            || (request.resource.data.awarded == true && monthOver(ym)));
    }
    function monthIdx(ym) { return int(ym.split('-')[0]) * 12 + int(ym.split('-')[1]); }
    // Month over in UTC terms, give or take a few hours against ET: good enough to hand out trophies.
    function monthOver(ym) { return monthIdx(ym) < request.time.year() * 12 + request.time.month(); }

    // ── Who can see a pin or an event ──
    // personal: only the owner. gang: everyone. limited: the ranks listed (leadership is always
    // listed) and anyone in one of the crews listed (checked against their own crewIds).
    function canSeeIt(d) {
      return d.get('owner', '') == myId()
        || (active() && (d.get('scope', '') == 'gang'
          || (d.get('scope', '') == 'limited'
              && (me().rankId in d.get('ranks', []) || d.get('crewIds', []).hasAny(me().get('crewIds', []))))));
    }
    // Admins count as leadership whatever their rank: admin is out-of-character, rank is in-character.
    function lead() { return isAdmin() || rankOf(me().rankId).get('leadership', false) == true || rankOf(me().rankId).order == 0
      || (hasRoles() && roles().get('lead', false) == true); }
    function validAudience(d) {
      return d.scope in ['personal', 'gang', 'limited'] && d.owner == myId()
        && d.ranks is list && d.ranks.size() <= 20 && d.crewIds is list && d.crewIds.size() <= 10;
    }

    match /pins/{id} {
      allow read: if canSeeIt(resource.data);
      function validPin() {
        let d = request.resource.data;
        return validAudience(d) && str(d.name, 40) && d.name.size() > 0 && str(d.type, 20)
          && d.x is number && d.x >= 0 && d.x <= 1 && d.y is number && d.y >= 0 && d.y <= 1
          && (!('note' in d) || str(d.note, 300))
          && str(d.get('postal', ''), 10) && str(d.get('access', ''), 300)
          && (d.get('photo', null) == null || str(d.photo, 450000))
          && (d.get('stashId', null) == null || str(d.stashId, 80))
          // Only leadership puts down rank- or crew-limited locations.
          && (d.scope != 'limited' || lead());
      }
      allow create: if active() && validPin();
      allow update: if active() && validPin() && (resource.data.owner == myId() || (lead() && resource.data.scope != 'personal'));
      allow delete: if active() && (resource.data.owner == myId() || ((lead() || can('manageEvents')) && resource.data.scope != 'personal'));
    }

    match /events/{id} {
      allow read: if canSeeIt(resource.data);
      function validEvent() {
        let d = request.resource.data;
        return validAudience(d) && str(d.title, 60) && d.title.size() > 0 && str(d.kind, 20)
          && d.start is timestamp && d.mins is int && d.mins > 0 && d.mins <= 7 * 24 * 60
          && d.repeat in ['none', 'daily', 'weekly', 'biweekly', 'monthly']
          && (!('note' in d) || str(d.note, 500)) && (!('place' in d) || str(d.place, 60))
          && (d.get('pinId', null) == null || str(d.pinId, 80))
          && d.rsvp is map;
      }
      allow create: if active() && validEvent() && request.resource.data.rsvp.keys().hasOnly([myId()]);
      allow update: if active() && (
        // The poster (or leadership, for shared events) edits it.
        ((resource.data.owner == myId() || ((lead() || can('manageEvents')) && resource.data.scope != 'personal')) && validEvent())
        // Anyone who can see it answers for themselves.
        || (canSeeIt(resource.data) && onlyChanges(['rsvp'])
            && request.resource.data.rsvp.diff(resource.data.rsvp).affectedKeys().hasOnly([myId()])
            && request.resource.data.rsvp.get(myId(), 'no') in ['yes', 'maybe', 'no']));
      allow delete: if active() && (resource.data.owner == myId() || (lead() && resource.data.scope != 'personal'));
    }

    // ── Gear & Loadouts ─────────────────────────────────────────
    // Shared weapon builds: anyone makes one; anyone likes (their own like only).
    // ---------- Money: the gang's books ----------
    function treasury() { return can('money') || lead(); }
    match /gangBook/{id} {
      allow read: if active() && treasury();
      allow create: if active() && can('money') && request.resource.data.by == myId() && request.resource.data.at == request.time
        && request.resource.data.dir in ['in', 'out'] && request.resource.data.cash in ['dirty', 'clean']
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && str(request.resource.data.category, 30) && str(request.resource.data.get('note', ''), 140)
        && request.resource.data.source in ['manual', 'dues', 'payout', 'spend', 'goal'];
      allow delete: if active() && can('money');
    }
    match /payouts/{id} {
      allow read: if active() && (resource.data.memberId == myId() || treasury());
      allow create: if active() && treasury() && request.resource.data.status == 'owed'
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.cash in ['dirty', 'clean'];
      allow update: if active() && (
        (can('money') && resource.data.status == 'owed' && request.resource.data.status == 'sent' && onlyChanges(['status', 'sentAt']))
        || (resource.data.memberId == myId() && resource.data.status == 'sent' && request.resource.data.status == 'received' && onlyChanges(['status'])));
      allow delete: if active() && treasury() && resource.data.status == 'owed';
    }
    match /budgets/{month} {
      allow read, write: if active() && treasury();
    }
    match /savingsGoals/{id} {
      allow read: if active();
      allow write: if active() && treasury();
    }
    match /spendRequests/{id} {
      allow read: if active() && (resource.data.by == myId() || treasury());
      allow create: if active() && mine('by') && request.resource.data.status == 'open'
        && request.resource.data.amount is int && request.resource.data.amount > 0 && str(request.resource.data.why, 140);
      allow update: if active() && treasury() && resource.data.status == 'open'
        && request.resource.data.status in ['approved', 'denied'] && onlyChanges(['status', 'decidedBy']) && request.resource.data.decidedBy == myId();
    }
    // Weekly dinner dues: amounts by rank (High Table), a snapshot per dinner, and cash payments.
    match /settings/dues {
      allow read: if active();
      allow write: if active() && lead();
    }
    match /duesWeeks/{week} {
      allow read: if active();
      allow create, update: if active() && (lead() || can('money') || can('confirmRep')) && week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /duesPay/{id} {
      allow read: if active();
      allow create: if active() && mine('memberId') && request.resource.data.status == 'pending'
        && request.resource.data.cash in ['dirty', 'clean'] && request.resource.data.amount is int && request.resource.data.amount > 0
        && getAfter(/databases/$(database)/documents/myCash/$(request.resource.data.cashId)).data.memberId == myId();
      // The Treasurer confirms or rejects; nobody confirms their own (except the top rank).
      allow update: if active() && can('money') && resource.data.status == 'pending'
        && (resource.data.memberId != myId() || myOrder() == 0)
        && request.resource.data.status in ['confirmed', 'rejected'] && onlyChanges(['status', 'decidedBy']) && request.resource.data.decidedBy == myId();
    }

    // ---------- Rivals ----------
    // Case files are everyone's to read; High Table (leadership) keeps them.
    match /rivals/{id} {
      allow read: if active();
      allow write: if active() && lead();
      match /members/{mid} {
        allow read: if active();
        allow write: if active() && lead();
        // Anyone who spots them updates when and where they were last seen.
        allow update: if active() && onlyChanges(['lastSeenAt', 'lastSeenWhere']) && request.resource.data.lastSeenAt == request.time && str(request.resource.data.lastSeenWhere, 60);
      }
    }
    match /rivalIncidents/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.by == myId() && request.resource.data.at == request.time
        && request.resource.data.kind in ['fight', 'robbery', 'turf', 'deal'] && str(request.resource.data.title, 80) && str(request.resource.data.notes, 1000);
      allow delete: if active() && (resource.data.by == myId() || lead());
    }
    match /rivalNotes/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.by == myId() && request.resource.data.at == request.time && str(request.resource.data.text, 500);
      allow delete: if active() && (resource.data.by == myId() || lead());
    }
    match /sightings/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.by == myId() && request.resource.data.at == request.time
        && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 12 && str(request.resource.data.note, 140);
      allow delete: if active() && (resource.data.by == myId() || lead());
    }
    match /bounties/{id} {
      allow read: if active();
      allow create: if active() && lead() && request.resource.data.status == 'open' && request.resource.data.amount is int && request.resource.data.amount > 0;
      allow update: if active() && (
        // Anyone claims an open bounty for themselves, with proof.
        (resource.data.status == 'open' && request.resource.data.status == 'claimed' && request.resource.data.claimBy == myId()
          && onlyChanges(['status', 'claimBy', 'claimName', 'claimProof', 'claimAt']) && str(request.resource.data.claimProof, 300))
        || lead());
    }
    match /rivalBoard/{id} {
      allow read: if active();
      allow write: if active() && lead();
    }

    // ---------- Welcome center ----------
    // Handlers are the Welcome Committee role, plus leadership. Associates see their own file.
    function handler() { return lead() || (hasRoles() && 'welcome' in roles().get('roles', [])); }
    match /settings/welcome {
      allow read: if active();
      allow write: if active() && handler() && request.resource.data.steps is list && request.resource.data.steps.size() <= 40
        && request.resource.data.sections is list && request.resource.data.sections.size() <= 20 && request.resource.data.rulesVersion is int;
    }
    match /onboarding/{mid} {
      allow read: if active() && (mid == myId() || handler());
      // Their own: accept the rules, and mark that they've seen their patch moment.
      allow create, update: if active() && mid == myId()
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['rulesAccepted', 'rulesAt', 'patchSeen'])
        && request.resource.data.get('rulesAt', request.time) == request.time;
      allow create, update: if active() && handler() && mid != myId();
    }
    match /welcomeStamps/{id} {
      allow read: if active() && (resource.data.memberId == myId() || handler());
      // They mark a step done; a handler confirms it.
      allow create: if active() && request.resource.data.status == 'pending' && request.resource.data.memberId == myId()
        && id == myId() + '_' + request.resource.data.stepId && request.resource.data.by == myId() && request.resource.data.at == request.time;
      allow create, update: if active() && handler() && request.resource.data.memberId != myId()
        && id == request.resource.data.memberId + '_' + request.resource.data.stepId;
      allow delete: if active() && ((resource.data.memberId == myId() && resource.data.status == 'pending') || handler());
    }
    match /handlerNotes/{id} {
      allow read, delete: if active() && handler();
      allow create: if active() && handler() && request.resource.data.by == myId() && request.resource.data.at == request.time && str(request.resource.data.text, 500);
    }
    // Anyone can vouch for or flag an associate; only handlers read them.
    match /vouches/{id} {
      allow read: if active() && (resource.data.by == myId() || handler());
      allow create: if active() && request.resource.data.by == myId() && request.resource.data.at == request.time
        && request.resource.data.memberId != myId() && request.resource.data.kind in ['vouch', 'flag'] && str(request.resource.data.text, 200);
      allow delete: if active() && (resource.data.by == myId() || handler());
    }
    match /welcomeNotes/{id} {
      allow read: if active() && (resource.data.to == myId() || handler());
      allow create: if active() && handler() && request.resource.data.by == myId() && request.resource.data.at == request.time && str(request.resource.data.text, 300);
      allow delete: if active() && (resource.data.to == myId() || handler());
    }
    match /graduations/{mid} {
      allow read: if active();
      allow write: if active() && lead();
    }

    // ---------- The Archives ----------
    // Members read (associates wait until they're blooded in); the Archivist and High Table write.
    function archivist() { return lead() || (hasRoles() && 'archivist' in roles().get('roles', [])); }
    function blooded() { return active() && me().rankId != 'associate'; }
    match /dinnerNotes/{date} {
      allow read: if blooded() && (resource.data.status == 'published' || archivist());
      allow write: if blooded() && archivist() && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    match /lore/{id} {
      allow read: if blooded() && (resource.data.status == 'published' || resource.data.by == myId() || archivist());
      // Anyone sends in a story; the Archivist approves it.
      allow create: if blooded() && request.resource.data.status == 'submitted' && request.resource.data.kind == 'story'
        && request.resource.data.by == myId() && request.resource.data.at == request.time
        && str(request.resource.data.title, 80) && request.resource.data.images.size() <= 4;
      allow create, update: if blooded() && archivist();
      allow delete: if blooded() && (archivist() || (resource.data.by == myId() && resource.data.status in ['submitted', 'rejected']));
    }
    match /timeline/{id} {
      allow read: if blooded();
      allow write: if blooded() && archivist();
    }
    match /archiveReacts/{id} {
      allow read: if blooded();
      allow create, update: if blooded() && request.resource.data.memberId == myId() && id == request.resource.data.target + '_' + myId()
        && request.resource.data.emoji in ['🔥', '👑', '🩸', '🥃', '💀'];
      allow delete: if blooded() && resource.data.memberId == myId();
    }

    // ---------- Roles ----------
    match /hqRoles/{id} {
      allow read: if active();
      allow write: if active() && (lead() || can('manageRanks'))
        && (request.resource == null || (str(request.resource.data.name, 30) && request.resource.data.perms is map && request.resource.data.pages is map));
    }
    match /roleHolders/{memberId} {
      allow read: if active();
      allow write: if active() && lead()
        && (request.resource == null || (request.resource.data.keys().hasOnly(['roles', 'perms', 'pages', 'lead'])
          && request.resource.data.roles is list && request.resource.data.roles.size() <= 20));
    }

    // ---------- Admin ----------
    // App-wide defaults (call-in cost, weekly goal, snapshot days, city clock) and editable lists (crime types, cars, products).
    match /settings/defaults {
      allow read: if active();
      allow write: if active() && (isAdmin() || can('manageSettings'));
    }
    match /settings/lists {
      allow read: if active();
      allow write: if active() && (isAdmin() || can('manageOps'))
        && request.resource.data.get('crimes', []) is list && request.resource.data.get('crimes', []).size() <= 40
        && request.resource.data.get('vehicles', []) is list && request.resource.data.get('vehicles', []).size() <= 300
        && request.resource.data.get('products', []) is list && request.resource.data.get('products', []).size() <= 40;
    }
    // Big actions, for admins only.
    match /adminFeed/{id} {
      allow read, delete: if active() && isAdmin();
      allow create: if active() && request.resource.data.by == myId() && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['kind', 'text', 'by', 'byName', 'target', 'reason', 'at'])
        && str(request.resource.data.kind, 20) && str(request.resource.data.text, 200)
        && str(request.resource.data.get('reason', ''), 140);
    }
    // A welcome note for a newcomer, shown on their first Dashboard until they dismiss it.
    match /welcomes/{memberId} {
      allow read: if active() && (myId() == memberId || can('approveMembers'));
      allow create, update: if active() && can('approveMembers') && str(request.resource.data.text, 300)
        && request.resource.data.keys().hasOnly(['text', 'by', 'byName', 'at']) && request.resource.data.by == myId();
      allow delete: if active() && (myId() == memberId || can('approveMembers'));
    }
    // BlackMarket price changes over time.
    match /priceLog/{id} {
      allow read: if active();
      allow create: if active() && (can('money') || isAdmin()) && request.resource.data.by == myId()
        && request.resource.data.keys().hasOnly(['product', 'price', 'was', 'by', 'byName', 'at'])
        && request.resource.data.price is int && request.resource.data.at == request.time;
    }
    // Owners only: merging a duplicate account or wiping a test one moves or removes that member's things.
    match /{coll}/{id} {
      allow read, update, delete: if coll in ['names', 'presence', 'sales', 'myCash', 'trophies', 'pettyLog', 'petty', 'repTransfers', 'builds', 'kits', 'kitPicks', 'signouts', 'lockerStock', 'stats', 'streaks', 'sheets', 'pettyGoals', 'shopping', 'welcomes', 'nudges'] && active() && isOwner();
      allow create: if coll in ['lockerStock', 'petty', 'stats', 'streaks', 'sheets', 'shopping', 'kitPicks'] && active() && isOwner();
    }

    match /builds/{id} {
      // Family builds are for everyone; private ones only for whoever made them.
      // Leadership and admins also see builds from before the family/private choice, so their page can mark them family.
      allow read: if active() && (resource.data.public == true || resource.data.by == myId() || can('manageOps'));
      function validBuild() {
        let d = request.resource.data;
        return str(d.name, 40) && d.name.size() > 0 && str(d.weaponId, 80) && d.parts is map && d.parts.size() <= 16
          && (!('notes' in d) || str(d.notes, 500))
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 6))
          && d.get('public', true) is bool;
      }
      allow create: if active() && validBuild() && request.resource.data.by == myId()
        && request.resource.data.likes is map && request.resource.data.likes.size() == 0
        && request.resource.data.get('saves', {}).size() == 0;
      allow update: if active() && (
        (resource.data.by == myId() && validBuild() && onlyChanges(['name', 'weaponId', 'parts', 'notes', 'tags', 'public']))
        || (onlyChanges(['likes']) && mapOnlyMine(request.resource.data.likes, resource.data.get('likes', {})))
        || (onlyChanges(['saves']) && mapOnlyMine(request.resource.data.saves, resource.data.get('saves', {})))
        || (!('public' in resource.data) && onlyChanges(['public']) && request.resource.data.public == true));
      allow delete: if active() && (resource.data.by == myId() || can('manageOps'));
    }
    // Admin pictures of guns, with where each attachment slot sits on the picture.
    match /gunArt/{weaponId} {
      allow read: if active();
      allow write: if can('manageOps')
        && (request.resource == null || (str(request.resource.data.image, 600000) && request.resource.data.anchors is map));
    }
    // Kits: named sets of what a member carries. Only the owner edits; public ones are for the
    // family, private ones for the owner and leadership.
    match /kits/{id} {
      function validKit() {
        let d = request.resource.data;
        return d.owner == myId() && str(d.name, 30) && d.name.size() > 0 && d.public is bool && d.mode in ['real', 'plan']
          && d.hotbar is list && d.hotbar.size() == 5 && d.bag is list && d.bag.size() <= 20
          && d.get('plates', 0) is int && d.get('plates', 0) >= 0 && d.get('plates', 0) <= 20
          && str(d.get('outfit', ''), 200)
          && d.keys().hasOnly(['owner', 'name', 'public', 'mode', 'hotbar', 'bag', 'vest', 'plates', 'bagType', 'outfit', 'vehicle', 'at']);
      }
      allow read: if active() && (resource.data.owner == myId() || resource.data.public == true || lead() || can('manageMembers'));
      allow create: if active() && validKit();
      allow update: if active() && resource.data.owner == myId() && validKit();
      allow delete: if active() && resource.data.owner == myId();
    }
    // A member's own shopping list. Private.
    match /shopping/{memberId} {
      allow read, delete: if active() && myId() == memberId;
      allow create, update: if active() && myId() == memberId
        && request.resource.data.keys().hasOnly(['items']) && request.resource.data.items is list
        && request.resource.data.items.size() <= 100;
    }
    // Which kit each member has equipped.
    match /kitPicks/{memberId} {
      allow read: if active();
      allow write: if active() && myId() == memberId
        && (request.resource == null || (request.resource.data.keys().hasOnly(['kit'])
          && (request.resource.data.kit == null || str(request.resource.data.kit, 40))));
    }
    // A member's character loadout: only they edit it. Public ones are seen by everyone,
    // private ones by the member and admins.
    match /loadouts/{memberId} {
      allow read: if active() && (myId() == memberId || resource.data.get('public', false) == true || lead() || can('manageMembers'));
      allow create, update: if active() && myId() == memberId
        && request.resource.data.keys().hasOnly(['public', 'vest', 'plates', 'primary', 'sidearm', 'melee', 'bag', 'utility', 'at'])
        && request.resource.data.get('public', false) is bool
        && request.resource.data.get('utility', []).size() <= 8;
      allow delete: if active() && myId() == memberId;
    }

    // Discord webhooks. Members read them (their phones send the alerts); only leadership edits.
    match /hooks/discord {
      allow read: if active();
      allow write: if can('manageSettings');
    }

    // Family cards: custom card art the Boss (or a rank given 'familyCards') uploads for each member.
    match /familyCards/{memberId} {
      allow read: if active();
      allow write: if can('familyCards')
        && (request.resource == null || (str(request.resource.data.image, 900000) && request.resource.data.by == myId()));
    }

    // One-time PIN reset codes. Only the SHA-256 of the code is stored.
    match /pinResets/{memberId} {
      allow create, update: if can('resetPins') && memberId != myId() && below(memberOf(memberId).rankId)
        && request.resource.data.keys().hasOnly(['codeHash', 'by', 'expiresAt', 'at'])
        && request.resource.data.by == myId() && request.resource.data.at == request.time;
      allow delete: if can('resetPins')
        || (signedIn() && getAfter(/databases/$(database)/documents/authLinks/$(request.auth.uid)).data.memberId == memberId);
    }

    // A fresh sign-in account made by redeeming a reset code, pointing at the member file.
    match /authLinks/{authUid} {
      allow read: if signedIn() && request.auth.uid == authUid;
      allow create: if signedIn() && request.auth.uid == authUid
        && request.resource.data.keys().hasOnly(['memberId', 'code'])
        && exists(/databases/$(database)/documents/pinResets/$(request.resource.data.memberId))
        && get(/databases/$(database)/documents/pinResets/$(request.resource.data.memberId)).data.expiresAt > request.time
        && hashing.sha256(request.resource.data.code).toHexString().lower()
           == get(/databases/$(database)/documents/pinResets/$(request.resource.data.memberId)).data.codeHash
        && !existsAfter(/databases/$(database)/documents/pinResets/$(request.resource.data.memberId));
    }
  }
}
