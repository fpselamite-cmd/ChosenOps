# Used by `npm run dev:emu`: talks to local Firebase emulators, no real project needed
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-chosenops.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-chosenops
VITE_FIREBASE_APP_ID=demo-app
VITE_NOELOPS_DB_URL=https://demo-chosenops-default-rtdb.firebaseio.com
